[Unit]
Description=sora: Akuma/amd64 in Firecracker (ryzen-akuma-amd64), 192.168.1.50
Requires=sora-net.service
After=sora-net.service

[Service]
# ryzen's own VM config and disk, as ../akuma amd64/run-firecracker.sh
# FC_KEEP_DISK=1 leaves them — never rebuilt from here. Root, because
# /dev/kvm is root:kvm and the laptop user isn't in kvm.
WorkingDirectory=/home/netoneko/akuma
ExecStartPre=/bin/sh -c 'mv -f boot.log boot.log.prev 2>/dev/null; true'
ExecStart=/home/netoneko/bin/firecracker --no-api --config-file akuma-vm.json
# The serial console, what `tail -f boot.log` has always been.
StandardOutput=append:/home/netoneko/akuma/boot.log
StandardError=inherit
StandardInput=null
Restart=on-failure
RestartSec=10
# The guest has 2 GiB (akuma-vm.json); a little over that for the VMM. It
# shares the box with the llama-server — keep either from starving it.
MemoryMax=2400M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
