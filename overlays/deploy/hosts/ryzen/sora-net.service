[Unit]
Description=sora's guest network: tap0 192.168.1.49, proxy-ARP for 192.168.1.50, DHCP pin
# Docker makes the DOCKER-USER chain (and sets FORWARD to DROP) and runs dnsmasq.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sora-net up
ExecStop=/usr/local/sbin/sora-net down

[Install]
WantedBy=multi-user.target
